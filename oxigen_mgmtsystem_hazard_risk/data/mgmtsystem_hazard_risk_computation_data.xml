<odoo>

    <record
        id="mgmtsystem_hazard_risk.risk_computation_a_times_b_times_c"
        model="mgmtsystem.hazard.risk.computation"
    >
        <field
            name="description"
        >Risk = Probability (A) x Severity (B) x Detectability (C)</field>
    </record>

    <record
        id="mgmtsystem_hazard_risk.risk_computation_a_times_b_plus_c"
        model="mgmtsystem.hazard.risk.computation"
    >
        <field
            name="description"
        >Risk = ( Probability (A) x Severity (B) ) + Detectability (C)</field>
    </record>

    <record
        id="mgmtsystem_hazard_risk.risk_computation_a_plus_b_times_c"
        model="mgmtsystem.hazard.risk.computation"
    >
        <field
            name="description"
        >Risk = ( Probability (A) + Severity (B) ) x Detectability (C)</field>
    </record>

    <record
        id="mgmtsystem_hazard_risk.risk_computation_a_plus_b_plus_c"
        model="mgmtsystem.hazard.risk.computation"
    >
        <field
            name="description"
        >Risk = Probability (A) + Severity (B) + Detectability (C)</field>
    </record>

</odoo>
