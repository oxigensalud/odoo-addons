<odoo noupdate="1">
    <!--
        allow_commit: queue_job 18.0 forbids commits inside a job unless its
        job function allows them, and the export path commits twice: the
        generic Exporter.run() of connector commits after binding the exported
        record, and the Oxigesti binder commits right after creating a binding
        (components_custom/binder.py, wrap_binding) so the binding survives a
        later failure of the job. Every job function whose method reaches one
        of them needs it: every export_record, the pricelist item export_chunk,
        which wraps the bindings itself, and the service and lot import_record,
        which export products and lots as dependencies. The batch jobs only
        enqueue, export_delete_record only calls the adapter and the partner
        import_record has no dependencies, so they never commit.
        Requires queue_job 18.0.3.1.4 or later, which rebinds the job
        arguments to the temporary cursor opened by allow_commit.
    -->
    <record
        id="oxigesti_res_partner_import_batch_job_function"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_oxigesti.model_oxigesti_res_partner" />
        <field name="method">import_batch</field>
        <field name="channel_id" ref="connector_oxigesti.channel_oxigesti_batch" />
        <field name="retry_pattern" eval="{1: 10, 5: 30, 10: 60, 15: 300}" />
    </record>
    <record
        id="oxigesti_res_partner_import_record_job_function"
        model="queue.job.function"
    >
        <field name="model_id" ref="connector_oxigesti.model_oxigesti_res_partner" />
