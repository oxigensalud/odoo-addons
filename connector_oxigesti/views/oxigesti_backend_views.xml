<odoo>
    <!-- Oxigesti backend -->
    <record id="oxigesti_backend_view_form" model="ir.ui.view">
        <field name="name">oxigesti.backend.form</field>
        <field name="model">oxigesti.backend</field>
        <field name="arch" type="xml">
            <form string="Oxigesti Backend">
                <header>
                    <button
                        name="button_check_connection"
                        type="object"
                        class="oe_highlight"
                        string="Check Connection"
                        invisible="state not in ['draft']"
                    />
                    <button
                        name="button_reset_to_draft"
                        type="object"
                        string="Reset To draft Connection"
                        invisible="state in ['draft']"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active == True"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Oxigesti"
                                readonly="state != 'draft'"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="lang_id" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group>
                        <group string="Connection">
                            <field name="server" readonly="state != 'draft'" />
                            <field name="port" readonly="state != 'draft'" />
                            <field name="database" readonly="state != 'draft'" />
                            <field name="schema" readonly="state != 'draft'" />
                            <field name="tz" readonly="state != 'draft'" />
                        </group>
                        <group col="1">
                            <group string="Credentials">
                                <field name="username" readonly="state != 'draft'" />
                                <field
                                    name="password"
                                    password="True"
                                    readonly="state != 'draft'"
                                />
                            </group>
                            <group string="Synchronization">
                                <field name="chunk_size" />
                                <field name="sync_offset" />
                            </group>
                        </group>
                    </group>
                    <group>
                        <field name="version" />
                    </group>
                    <notebook invisible="state in ['draft']">
                        <page name="synchronizers" string="Synchronizers">
                            <p class="text-muted">
                                By clicking on the buttons,
                                you will initiate the
                                synchronizations
                                with Oxigesti.
                                Note that the import or exports
                                won't be done directly,
                                they will create 'Jobs'
                                executed as soon
                                as possible.
                            </p>
                            <p class="text-muted">
                                Once imported,
                                some types of records,
                                like the products
                                or categories,
                                need a manual review.
                                You will find the list
                                of the
                                new records to review
                                in the menu 'Connectors > Checkpoint'.
                            </p>
                            <group>
                                <div>
                                    <label
                                        string="Import Customers since"
                                        class="oe_inline"
                                        for="import_customers_since_date"
                                    />
                                    <field
                                        name="import_customers_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="import_customers_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Import in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Export Products since"
                                        class="oe_inline"
                                        for="export_products_since_date"
                                    />
                                    <field
                                        name="export_products_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="export_products_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Export in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Export Product Categories since"
                                        class="oe_inline"
                                        for="export_product_categories_since_date"
                                    />
                                    <field
                                        name="export_product_categories_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="export_product_categories_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Export in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Export Products by customer since"
                                        class="oe_inline"
                                        for="export_products_by_customer_since_date"
                                    />
                                    <field
                                        name="export_products_by_customer_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="export_products_by_customer_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Export in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Export Product prices by customer since"
                                        class="oe_inline"
                                        for="export_product_prices_by_customer_since_date"
                                    />
                                    <field
                                        name="export_product_prices_by_customer_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="export_product_prices_by_customer_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Export in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Import Lots since"
                                        class="oe_inline"
                                        for="import_stock_production_lot_since_date"
                                    />
                                    <field
                                        name="import_stock_production_lot_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="import_stock_production_lot_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Import in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Export Lots since"
                                        class="oe_inline"
                                        for="export_stock_production_lot_since_date"
                                    />
                                    <field
                                        name="export_stock_production_lot_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="export_stock_production_lot_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Export in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Import Services since"
                                        class="oe_inline"
                                        for="import_services_since_date"
                                    />
                                    <field
                                        name="import_services_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="import_services_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Import in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Export Services since"
                                        class="oe_inline"
                                        for="export_services_since_date"
                                    />
                                    <field
                                        name="export_services_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="export_services_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Export in background"
                                />
                            </group>
                        </page>
                        <page name="additional_data" string="Additional data">
                            <group>
                                <field name="warehouse_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="oxigesti_backend_view_tree" model="ir.ui.view">
        <field name="name">oxigesti.backend.list</field>
        <field name="model">oxigesti.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" />
                <field name="server" />
                <field name="port" />
                <field name="database" />
                <field name="schema" />
            </list>
        </field>
    </record>

    <record id="oxigesti_backend_action" model="ir.actions.act_window">
        <field name="name">Oxigesti Backends</field>
        <field name="res_model">oxigesti.backend</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
