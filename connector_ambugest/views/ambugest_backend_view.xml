<odoo>
    <!-- Ambugest backend -->
    <record id="ambugest_backend_view_form" model="ir.ui.view">
        <field name="name">ambugest.backend.form</field>
        <field name="model">ambugest.backend</field>
        <field name="arch" type="xml">
            <form string="Ambugest Backend">
                <header>
                    <button
                        name="button_check_connection"
                        type="object"
                        class="oe_highlight"
                        string="Check Connection"
                        invisible="state not in ['draft']"
                    />
                    <button
                        name="button_reset_to_draft"
                        type="object"
                        string="Reset To draft Connection"
                        invisible="state in ['draft']"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active == True"
                    />
                    <field name="active" invisible="1" />
                    <h1>
                        <field
                            name="name"
                            class="oe_inline"
                            readonly="state != 'draft'"
                        />
                    </h1>
                    <group>
                        <field name="company_id" readonly="state != 'draft'" />
                    </group>
                    <group>
                        <group>
                            <field name="server" readonly="state != 'draft'" />
                            <field name="port" readonly="state != 'draft'" />
                            <field name="database" readonly="state != 'draft'" />
                            <field name="schema" readonly="state != 'draft'" />
                        </group>
                        <group col="4">
                            <field name="username" readonly="state != 'draft'" />
                            <field
                                name="password"
                                password="True"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group>
                            <field name="tz" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field
                                name="ambugest_company_id"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="version" />
                    </group>
                    <notebook invisible="state in ['draft']">
                        <page name="import" string="Imports">
                            <p class="oe_grey oe_inline">
                                By clicking on the buttons,
                                you will initiate the
                                synchronizations
                                with Ambugest.
                                Note that the import or exports
                                won't be done directly,
                                they will create 'Jobs'
                                executed as soon
                                as possible.
                            </p>
                            <p class="oe_grey oe_inline">
                                Once imported,
                                some types of records,
                                like the products
                                or categories,
                                need a manual review.
                                You will find the list
                                of the
                                new records to review
                                in the menu 'Connectors > Checkpoint'.
                            </p>
                            <group>
                                <div>
                                    <label
                                        string="Import Products since"
                                        class="oe_inline"
                                        for="import_products_since_date"
                                    />
                                    <field
                                        name="import_products_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="import_products_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Import in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Import Customers since"
                                        class="oe_inline"
                                        for="import_customers_since_date"
                                    />
                                    <field
                                        name="import_customers_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="import_customers_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Import in background"
                                />
                            </group>
                            <group>
                                <div>
                                    <label
                                        string="Import Services since"
                                        class="oe_inline"
                                        for="import_services_since_date"
                                    />
                                    <field
                                        name="import_services_since_date"
                                        class="oe_inline"
                                        nolabel="1"
                                    />
                                </div>
                                <button
                                    name="import_services_since"
                                    type="object"
                                    class="oe_highlight"
                                    string="Import in background"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ambugest_backend_view_tree" model="ir.ui.view">
        <field name="name">ambugest.backend.list</field>
        <field name="model">ambugest.backend</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" />
                <field name="server" />
                <field name="port" />
                <field name="database" />
                <field name="schema" />
                <field name="ambugest_company_id" />
            </list>
        </field>
    </record>

    <record id="ambugest_backend_action" model="ir.actions.act_window">
        <field name="name">Ambugest Backends</field>
        <field name="res_model">ambugest.backend</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
