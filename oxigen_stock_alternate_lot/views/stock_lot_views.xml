<odoo>
    <record id="view_production_lot_form" model="ir.ui.view">
        <field name="name">stock.alternate.lot.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <group name="main_group" position="after">
                <group invisible="nos_enabled == False and dn_enabled == False">
                    <field name="nos_enabled" invisible="1" />
                    <field name="dn_enabled" invisible="1" />
                    <field name="unknown_readonly" invisible="1" />
                    <group col="4">
                        <field
                            name="nos"
                            invisible="nos_enabled == False"
                            required="nos_enabled == True and nos_unknown == False"
                            readonly="nos_unknown == True"
                            force_save="1"
                        />
                        <field
                            name="nos_unknown"
                            string="Unknown"
                            invisible="nos_enabled == False"
                            required="nos_enabled == True"
                            readonly="unknown_readonly == True"
                        />
                        <field
                            name="dn"
                            invisible="dn_enabled == False"
                            required="dn_enabled == True and dn_unknown == False"
                            readonly="dn_unknown == True"
                            force_save="1"
                        />
                        <field
                            name="dn_unknown"
                            string="Unknown"
                            invisible="dn_enabled == False"
                            required="dn_enabled == True"
                            readonly="unknown_readonly == True"
                        />
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
