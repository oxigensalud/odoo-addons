<odoo>
    <record id="document_page_archive_wizard_form" model="ir.ui.view">
        <field name="name">document.page.archive.wizard.form</field>
        <field name="model">document.page.archive.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="document_page_ids" invisible="1" />
                <field name="archive" invisible="1" />
                <p attrs="{'invisible': [('archive', '=', False)]}">
                    You are about to archive the selected document page(s).
                    Please provide a reason — it will be logged in the document
                    chatter for traceability.
                </p>
                <p attrs="{'invisible': [('archive', '=', True)]}">
                    You are about to unarchive the selected document page(s).
                    Please provide a reason — it will be logged in the document
                    chatter for traceability.
                </p>
                <group>
                    <field
                        name="reason"
                        placeholder="e.g. Replaced by procedure P-016 revision 03"
                        nolabel="1"
                    />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
