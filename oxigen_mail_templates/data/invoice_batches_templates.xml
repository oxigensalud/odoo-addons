<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_batch_email_template" model="mail.template">
        <field name="name">Lote de factura Oxigen Salud S.A.</field>
        <field name="model_id" ref="account.model_account_move" />
        <field
            name="subject"
        >{{ object.company_id.name }} - Invoice {{ object.name or 'n/a' }}</field>
        <field
            name="email_from"
        >"Oxigen Salud S.A." &lt;facturacion@oxigensalud.com&gt;</field>
        <field name="partner_to">{{ object.invoice_batch_email_partner_id.id }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-if="object.partner_id.parent_id">
                        <t t-out="object.partner_id.name or ''">Partner Name</t> (<t
                    t-out="object.partner_id.parent_id.name or ''"
                >Parent Company</t>),
                    </t>
                    <t t-else="">
                        <t t-out="object.partner_id.name or ''">Partner Name</t>,
                    </t>
                    <br /><br />
                    Here is, in attachment, your
                    <t t-if="object.name">
                        invoice <strong t-out="object.name or ''">INV/2024/0001</strong>
                    </t>
                    <t t-else="">
                        invoice
                    </t>
                    <t t-if="object.invoice_origin">
                        (with reference: <t
                    t-out="object.invoice_origin or ''"
                >SO001</t>)
                    </t>
                    amounting in <strong
                    t-out="format_amount(object.amount_total, object.currency_id) or ''"
                >$ 1,000.00</strong>
                    from <t t-out="object.company_id.name or ''">Your Company</t>.
                    <t t-if="object.payment_state in ('paid', 'in_payment')">
                        This invoice is already paid.
                    </t>
                    <t t-else="">
                        Please remit payment at your earliest convenience.
                        <t t-if="object.payment_reference">
                            <br /><br />
                            Please use the following communication for your payment: <strong
                    t-out="object.payment_reference or ''"
                >Payment Reference</strong>.
                        </t>
                    </t>
                    <br /><br />
                    Do not hesitate to contact us if you have any questions.
                    <t t-if="not is_html_empty(object.invoice_user_id.signature)">
                    <br />
                    <t t-out="object.invoice_user_id.signature or ''">--<br
                    />User Signature</t>
                </t>
                </p>
            </div>
        </field>
        <field
            name="report_template_ids"
            eval="[(4, ref('account_invoice_report_service.action_report_invoice_delivery'))]"
        />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="False" />
    </record>
</odoo>
