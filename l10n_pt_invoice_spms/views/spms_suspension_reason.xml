<odoo>

    <record model="ir.ui.view" id="spms_suspension_reason_form_view">
        <field name="model">spms.suspension.reason</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="spms_suspension_reason_search_view">
        <field name="model">spms.suspension.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="spms_suspension_reason_tree_view">
        <field name="model">spms.suspension.reason</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="spms_suspension_reason_act_window">
        <field name="name">SPMS Suspension Reason</field>
        <field name="res_model">spms.suspension.reason</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="spms_suspension_reason_menu">
        <field name="name">Suspension Reason</field>
        <field name="parent_id" ref="spms_root_menu" />
        <field name="action" ref="spms_suspension_reason_act_window" />
        <field name="sequence" eval="30" />
    </record>

</odoo>
