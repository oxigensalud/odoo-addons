<odoo>

    <record model="ir.ui.view" id="account_move_form_view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']"
                position="after"
            >
                <button
                    name="action_spms_send_invoice"
                    type="object"
                    icon="fa-bullseye"
                    attrs="{'column_invisible': [('parent.spms_send_invoice', '=', False)]}"
                />
                <field name="spms_send_invoice" invisible="1" />
            </xpath>
            <field name="move_type" position="after">
                <field name="spms_send_invoice" invisible="1" />
            </field>
        </field>
    </record>



</odoo>
