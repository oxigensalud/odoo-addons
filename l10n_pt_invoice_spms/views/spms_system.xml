<odoo>

    <record model="ir.ui.view" id="spms_system_form_view">
        <field name="model">spms.system</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="unit_price" />
                        <field name="contract_number" />
                        <field name="lot_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="spms_system_search_view">
        <field name="model">spms.system</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <field name="contract_number" />
                <field name="lot_id" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="spms_system_tree_view">
        <field name="model">spms.system</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="contract_number" />
                <field name="lot_id" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="spms_system_act_window">
        <field name="name">SPMS System</field>
        <field name="res_model">spms.system</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="spms_system_menu">
        <field name="name">System</field>
        <field name="parent_id" ref="spms_root_menu" />
        <field name="action" ref="spms_system_act_window" />
        <field name="sequence" eval="20" />
    </record>

</odoo>
