<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_barcodes_read_picking_form" model="ir.ui.view">
        <field
            name="name"
        >stock.barcodes.read.picking.form - oxigen_stock_barcodes</field>
        <field name="model">wiz.stock.barcodes.read.picking</field>
        <field
            name="inherit_id"
            ref="stock_barcodes.view_stock_barcodes_read_picking_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_validate_picking']" position="before">
                <field name="do_show_action_confirm" invisible="1" />
                <button
                    name="action_confirm_picking"
                    type="object"
                    icon="fa-check-double"
                    class="btn btn-secondary w-100 oe_kanban_action_button btn-sm text-uppercase d-flex justify-content-center align-items-center fs-2"
                    invisible="do_show_action_confirm == False"
                    confirm="Are you sure to confirm and validate the picking?"
                    data-hotkey="'shift+c'"
                >
                    <span class="d-none d-lg-block">Confirm and Validate</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
