<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ************************************************************* -->
    <!-- Fiscal Position Tax Templates -->
    <!-- ************************************************************* -->

    <!-- The non-deductible mapping lines on the official
         intra-community and IRPF 15 positions moved to
         l10n_es_extension 14.0.2.0.0 (same terminal xml-id names);
         the 14.0.1.1.0 migration hands the existing records over in
         place. The DUA lines below stay here: they need l10n_es_dua,
         which the generic module does not depend on. -->

    <!-- DUA -->

     <!--     4% -->
    <record id="fptt_dua_4nd_s" model="account.fiscal.position.tax.template">
        <field name="position_id" ref="l10n_es_dua.fp_dua" />
        <field name="tax_src_id" ref="l10n_es.account_tax_template_p_iva4_nd" />
        <field name="tax_dest_id" ref="l10n_es_dua.account_tax_template_p_dua0" />
   </record>

    <record id="fptt_dua_4nd_bc" model="account.fiscal.position.tax.template">
        <field name="position_id" ref="l10n_es_dua.fp_dua" />
