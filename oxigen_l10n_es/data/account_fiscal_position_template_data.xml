    <!-- ************************************************************* -->
    <!-- Fiscal Position Account Templates -->
    <!-- ************************************************************* -->
    <!-- Revenue account swaps on the official TAI position: the
         official l10n_es only defines them on fp_extra and fp_intra,
         and this client books not-subject sales on the export
         accounts. Declared here (not in l10n_es_extension) because the
         choice is an accounting policy of this client, not a generic
         rule. The 14.0.1.2.0 migration materializes them on existing
         companies. -->

    <record id="fpat_tai_acc_1" model="account.fiscal.position.account.template">
        <field name="position_id" ref="l10n_es.fp_not_subject_tai" />
        <field name="account_src_id" ref="l10n_es.account_common_7000" />
        <field name="account_dest_id" ref="l10n_es.account_common_7002" />
    </record>
    <record id="fpat_tai_acc_2" model="account.fiscal.position.account.template">
