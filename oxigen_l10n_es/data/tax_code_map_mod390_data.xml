<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- AEAT 390 map (exercises up to 2023): add the non-deductible VAT
         family to the boxes where its official deductible analogues sit.
         Accrual boxes only (21-26 intra-EU goods, 545-552 intra-EU services,
         29/30 purchase modifications) plus the informative boxes 232
         (non-deductible input VAT bases, per the AEAT 390 instructions) and
         105 (exempt sales without deduction right, s_iva0_sdd). No deduction
         box gets any member: these taxes carry no deduction right. The
         service-quota boxes (546/548/552) are measured by OCA through the
         472 account the family never posts to, so dedicated lines filtered
         by 477 (the account the family's accrual leg posts to, same
         mechanism as the official goods-quota lines 22/24/26) are added for
         them. -->
    <record
        id="l10n_es_aeat_mod390.aeat_mod390_map_line_21"
        model="l10n.es.aeat.map.tax.line"
    >
        <field
            name="tax_xmlid_ids"
            eval="[
                (4, ref('p_iva4nd_ic_bc')),
                (4, ref('p_iva4nd_ic_bi')),
            ]"
        />
    </record>

    <record
        id="l10n_es_aeat_mod390.aeat_mod390_map_line_22"
